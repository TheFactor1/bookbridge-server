# Copy this file to .env and fill in what applies. Every setting has a
# working default; `docker compose up -d` with this file untouched starts
# Shelfmark alone and nothing else.
#
#   cp .env.example .env
#   docker compose up -d

# ---------------------------------------------------------------------------
# What to run. Comma-separated. Leave empty for Shelfmark alone.
#
#   sync      library sync with Calibre-Web-NextGen
#   annas     Anna's Archive as the primary search source
#   ai-local  match suggestions using a local model (needs ~8GB free RAM)
#   ai-cloud  match suggestions using an API key instead of a local model
#
# Examples:  COMPOSE_PROFILES=sync
#            COMPOSE_PROFILES=sync,annas,ai-local
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# General
TZ=UTC
# The user and group that own files the containers write. On most Linux
# machines your own user is 1000/1000; `id -u` and `id -g` will tell you.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Ports on this machine. Change one only if something else already uses it.
SHELFMARK_PORT=8084
CWA_PORT=8083
ANNAS_API_PORT=8087
AI_RELAY_PORT=8089
PAIRING_PORT=8086

# ---------------------------------------------------------------------------
# sync profile
#
# The folder that holds (or will hold) Calibre's metadata.db. Leave blank
# to start a new, empty library in ./calibre-library next to this file; set
# it to point CWA at a library you already have.
CALIBRE_LIBRARY=

# Optional. A Hardcover API token turns on CWA's Hardcover metadata
# provider, which fills in series name and index -- the plugin's
# series-aware matching uses that when it's there. Get one at
# https://hardcover.app/account/api
HARDCOVER_TOKEN=

# ---------------------------------------------------------------------------
# ai-local / ai-cloud profiles
#
# Needed for either: a long random string. Put the same value into the
# plugin's "AI relay token" setting. It grants nothing except the ability to
# ask the relay to compare a filename against a list of titles. Left blank,
# the relay runs but refuses every request until you set one.
#   openssl rand -hex 32     is a fine way to make one
RELAY_TOKEN=

# ai-cloud only. Leave all three alone for ai-local.
#   AI_PROVIDER=anthropic
#   AI_API_KEY=sk-ant-...
#   AI_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER=openai
AI_API_BASE=http://ollama:11434/v1
AI_MODEL=qwen2.5:7b-instruct
AI_API_KEY=

# ai-local only. The ceiling for the model container, not a requirement --
# but a 7B model needs about 8GB actually free to run.
OLLAMA_MEM_LIMIT=12g

# ---------------------------------------------------------------------------
# Connecting readers with a code (Bookbridge > Connect a book server).
# install.sh fills these in. By hand: BB_PASSWORD is what you type on the
# approval page; the logins are what the reader is handed.
BB_PASSWORD=
SERVER_NAME=
SHELFMARK_USERNAME=
SHELFMARK_PASSWORD=
CWA_USERNAME=admin
CWA_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Pinned versions. Bump deliberately; `latest` for the two GHCR images means
# whatever was last published from this project.
SHELFMARK_VERSION=v1.3.14
CWA_VERSION=v4.1.43
OLLAMA_VERSION=0.12.3
ANNAS_API_VERSION=latest
AI_RELAY_VERSION=latest
